"""Arinze's heart: fun facts, learning about you, and little habits that make him feel at home.

Everything here stays on your Mac. Files (all in ~/Arinze):
  arinze_settings.json  switches and timings (edit it; he re-reads it every 30 seconds)
  memory.json           what he has learned from your chats (plain text, edit or delete freely)
  brain_state.json      which fun facts he has told, app/time counters, your daily streak
  facts_extra.txt       OPTIONAL: your own fun facts, one per line, he mixes them in

Things you can say to him in "Talk to Arinze":
  what do you know about me      forget that      forget <word>      forget everything
  remember that <something>      fun fact         stop/start learning      stop/start fun facts
  stop/start tracking my apps
"""
import os, re, json, time, random, threading, subprocess, atexit, datetime
import requests

try:
    from AppKit import NSWorkspace
except Exception:
    NSWorkspace = None
try:
    from Quartz import (CGEventSourceSecondsSinceLastEventType,
                        kCGEventSourceStateCombinedSessionState, kCGAnyInputEventType)
except Exception:
    CGEventSourceSecondsSinceLastEventType = None

HOME = os.path.expanduser("~/Arinze")
MEM_PATH = os.path.join(HOME, "memory.json")
STATE_PATH = os.path.join(HOME, "brain_state.json")
SETTINGS_PATH = os.path.join(HOME, "arinze_settings.json")
EXTRA_FACTS = os.path.join(HOME, "facts_extra.txt")

DEFAULTS = {
    "fun_facts": True,
    "fact_minutes": [30, 90],        # a fun fact every so many minutes (random between the two)
    "surprises": True,
    "surprise_minutes": [90, 240],   # "something I noticed about you" every so many minutes
    "learn_from_chat": True,         # learn lasting facts from what you tell him
    "track_apps": True,              # count which app is in front and when you are around (local only)
    "welcome_back": True,
    "late_night_nudge": True,        # one gentle "go to sleep" between 1am and 5am
    "react_power": True,             # he notices when you plug in the charger
    "react_spotify": True,           # he sometimes comments on the song that starts playing
    "quiet_hours": [],               # for example [23, 7] = no facts or chatter from 11pm to 7am
}

MAX_FACTS = 150
CALM = {"idle", "happy", "big_smile", "cheerful", "content", "bored", "cool", "sunglasses", "wink"}
