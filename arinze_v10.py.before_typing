class Bubble(QLabel):
    def __init__(self):
        super().__init__()
        self.setWindowFlags(Qt.WindowType.FramelessWindowHint |
                            Qt.WindowType.WindowStaysOnTopHint |
                            Qt.WindowType.WindowTransparentForInput)
        self.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground)
        self.setAttribute(Qt.WidgetAttribute.WA_ShowWithoutActivating)
        self.setStyleSheet("background: transparent; color: white;")
        self.setContentsMargins(16, 10, 16, 10)
        f = QFont()
        f.setPointSize(14)
        f.setWeight(QFont.Weight.Medium)
        self.setFont(f)
        self.setWordWrap(True)
        self.bx = 0
        self.by = 0
        self.hide_timer = QTimer(self)
        self.hide_timer.setSingleShot(True)
        self.hide_timer.timeout.connect(self.hide)

    def paintEvent(self, e):
        # solid, opaque dark background with a light border so text is readable on any wallpaper
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        r = QRectF(self.rect()).adjusted(1.5, 1.5, -1.5, -1.5)
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(QColor(14, 14, 32, 255))
        p.drawRoundedRect(r, 14, 14)
        p.end()
        super().paintEvent(e)

    def show_text(self, text, geo):
        fn = SPEAK["fn"]
        if fn is not None:
            try:
                fn(text)
            except Exception:
                pass
        self.setText(text)
        w = max(120, min(320, self.fontMetrics().horizontalAdvance(text) + 56))
        self.setFixedWidth(w)
        self.setFixedHeight(self.heightForWidth(w) + 6)
        sc = QApplication.screenAt(geo.center()) or QApplication.primaryScreen()
        self.bounds = sc.availableGeometry()
        x = geo.x() + (geo.width() - w) // 2
        y = geo.y() - self.height() - 2
        if y < self.bounds.top() + 4:
            y = geo.bottom() + 2
        x = max(self.bounds.left() + 8, min(x, self.bounds.right() - w - 8))
        y = max(self.bounds.top() + 4, min(y, self.bounds.bottom() - self.height() - 4))
        self.bx, self.by = x, y
        self.anchor = (geo.x(), geo.y())
        self.move(x, y)
        self.show()
        self.raise_()
        apply_float(self)
        self.hide_timer.start(min(BUBBLE_MAX_MS, max(BUBBLE_MIN_MS, BUBBLE_BASE_MS + BUBBLE_PER_CHAR_MS * len(text))))

    def follow(self, dy, ax=None, ay=None):
        # stays attached to him, even while he glides across the screen
        if self.isVisible():
            a = getattr(self, "anchor", None)
            sx = (ax - a[0]) if (a and ax is not None) else 0
            sy = (ay - a[1]) if (a and ay is not None) else 0
            nx, ny = self.bx + sx, self.by + sy - dy
            b = getattr(self, "bounds", None)
            if b is not None:
                nx = max(b.left() + 8, min(nx, b.right() - self.width() - 8))
                ny = max(b.top() + 4, min(ny, b.bottom() - self.height() - 4))
            self.move(nx, ny)


