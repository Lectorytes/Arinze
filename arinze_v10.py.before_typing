def apply_float(widget):
    # Keeps the window above everything, on every desktop, even over full-screen apps.
    try:
        view = objc.objc_object(c_void_p=ctypes.c_void_p(int(widget.winId())))
        win = view.window()
        win.setLevel_(101)
        win.setCollectionBehavior_(1 | 16 | 64 | 256)
        win.setHidesOnDeactivate_(False)
    except Exception:
        pass


def notif_windows():
    # Looks for Notification Center windows currently on screen.
    out = {}
    try:
        info = CGWindowListCopyWindowInfo(kCGWindowListOptionOnScreenOnly, kCGNullWindowID) or []
        for wi in info:
            owner = str(wi.get("kCGWindowOwnerName", ""))
            if "notification" not in owner.lower():
                continue
            b = wi.get("kCGWindowBounds", {})
            out[int(wi.get("kCGWindowNumber", 0))] = (
                int(wi.get("kCGWindowLayer", 0)),
                int(b.get("Width", 0)), int(b.get("Height", 0)))
    except Exception:
        pass
    return out


def ax_get(el, attr):
    try:
        err, val = AXUIElementCopyAttributeValue(el, attr, None)
        return val if err == 0 else None
    except Exception:
        return None


def ax_rect(val):
    try:
        ok, r = AXValueGetValue(val, kAXValueCGRectType, None)
        if ok:
            return (float(r.origin.x), float(r.origin.y), float(r.size.width), float(r.size.height))
    except Exception:
        pass
    return None


def ax_frame(el):
    try:
        pos = ax_get(el, "AXPosition")
        size = ax_get(el, "AXSize")
        if pos is None or size is None:
            return None
        ok1, pt = AXValueGetValue(pos, kAXValueCGPointType, None)
        ok2, sz = AXValueGetValue(size, kAXValueCGSizeType, None)
        if ok1 and ok2:
            return (float(pt.x), float(pt.y), float(sz.width), float(sz.height))
    except Exception:
        pass
    return None


def focus_info(woken):
    # Where is the text you are typing? Asks macOS Accessibility for the text box and the caret.
    try:
        app = NSWorkspace.sharedWorkspace().frontmostApplication()
        if app is None:
            return None
        pid = int(app.processIdentifier())
        if pid == os.getpid():
            return None
        ax_app = AXUIElementCreateApplication(pid)
        if AX_WAKE and pid not in woken:
            woken.add(pid)
            try:
                AXUIElementSetAttributeValue(ax_app, "AXManualAccessibility", True)
            except Exception:
                pass
        el = ax_get(ax_app, "AXFocusedUIElement")
        if el is None:
            return None
        out = {"box": ax_frame(el), "caret": None}
        rng = ax_get(el, "AXSelectedTextRange")
        if rng is not None:
            err, b = AXUIElementCopyParameterizedAttributeValue(el, "AXBoundsForRange", rng, None)
            if err == 0 and b is not None:
                r = ax_rect(b)
                if r and r[3] > 0 and not (r[0] == 0 and r[1] == 0):
                    out["caret"] = r
        if out["box"] is None and out["caret"] is None:
            return None
        return out
    except Exception:
        return None


def glow_path(p, path, rgb):
    # Draws a neon-style glowing line, like the lines in his face.
    for width, alpha in ((16, 35), (10, 80), (5, 255)):
        pen = QPen(QColor(rgb[0], rgb[1], rgb[2], alpha), width * K)
        pen.setCapStyle(Qt.PenCapStyle.RoundCap)
        p.setPen(pen)
        p.drawPath(path)
    p.setPen(Qt.PenStyle.NoPen)


def _pairs(pairs):
    # if the model repeats a key, keep the real value rather than a later null
    d = {}
    for k, v in pairs:
        if k not in d or (d[k] is None and v is not None):
            d[k] = v
    return d


